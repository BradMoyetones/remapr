<?xml version="1.0" encoding="utf-8"?>
<!-- Remapr's Windows installer. Built by `cargo xtask dist`, which passes Version and the paths of
     the executable, icon, wizard art and licence. Per machine: installing asks for administrator
     rights once. The wizard is WiX's own, in Spanish (`-culture es-ES`). -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- Never change the UpgradeCode: it is how a new version finds and replaces the old one. -->
  <Package Name="Remapr" Manufacturer="Brad Moyetones" Version="$(var.Version)"
           UpgradeCode="F78FBC0B-EA74-409C-8427-9D3F05244D41" Scope="perMachine" Language="3082" Codepage="1252">
    <SummaryInformation Description="Remapr, reasignador de teclas" />
    <!-- Same-version upgrades let a rebuilt installer replace an installed copy of the same version. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="Ya hay instalada una versión más nueva de Remapr." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches the icon under its Id; advertised shortcuts need an .exe-like Id (ICE50). -->
    <Icon Id="RemaprIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="RemaprIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/BradMoyetones/remapr" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Remapr" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- The app reads where it was installed from here (to tell the installed copy from a dev
         build), and an upgrade, or the updater's silent install, goes back to the same folder. -->
    <Property Id="PREVIOUSINSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\Remapr" Name="InstallDir" Type="raw" />
    </Property>
    <SetDirectory Id="INSTALLFOLDER" Value="[PREVIOUSINSTALLFOLDER]" Condition="PREVIOUSINSTALLFOLDER" />

    <Feature Id="Main" Title="Remapr">
      <Component Directory="INSTALLFOLDER">
        <File Id="RemaprExe" Name="remapr.exe" Source="$(var.ExePath)" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Name="Remapr" Directory="ProgramMenuFolder" Advertise="yes"
                    Icon="RemaprIcon.exe" WorkingDirectory="INSTALLFOLDER" />
        </File>
        <RegistryValue Root="HKLM" Key="Software\Remapr" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" />
      </Component>
    </Feature>

    <!-- The wizard: welcome, licence, folder, progress, finish; with Remapr's own art. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="Remapr ya está abierto. Vive en la bandeja del sistema, junto al reloj, y se inicia con Windows." />

    <!-- A running Remapr holds remapr.exe open, and closing its window only hides it to the tray:
         end every copy (as SYSTEM, so elevated ones too) before files are removed or replaced. -->
    <CustomAction Id="EndRemapr" Directory="System64Folder"
                  ExeCommand="&quot;[System64Folder]taskkill.exe&quot; /F /IM remapr.exe"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- The sign-in task is Remapr's own code (crates/platform/src/startup.rs), run as SYSTEM. -->
    <CustomAction Id="RegisterTask" FileRef="RemaprExe" ExeCommand="--register-task"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="UnregisterTask" FileRef="RemaprExe" ExeCommand="--unregister-task"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- As the user: an elevated copy starts through the task, so installing (and updating) ends
         with Remapr open. -->
    <CustomAction Id="StartRemapr" FileRef="RemaprExe" ExeCommand="" Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="EndRemapr" After="InstallInitialize" />
      <Custom Action="RegisterTask" After="InstallFiles" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <!-- An upgrade removes the old version first; keep its task (and the user's choice). -->
      <Custom Action="UnregisterTask" Before="RemoveFiles"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="StartRemapr" After="InstallFinalize" Condition="NOT REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
